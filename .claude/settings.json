{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__Supabase__list_*",
      "mcp__Supabase__get_*",
      "mcp__Supabase__search_docs",
      "mcp__Vercel__get_*",
      "mcp__Vercel__list_*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(gh pr merge*)",
      "mcp__*__merge_pull_request",
      "mcp__*__enable_pr_auto_merge",
      "mcp__*__apply_migration",
      "mcp__*__create_project",
      "mcp__*__pause_project",
      "mcp__*__restore_project",
      "mcp__*__merge_branch",
      "mcp__*__reset_branch",
      "mcp__*__rebase_branch",
      "mcp__*__delete_branch",
      "mcp__*__deploy_edge_function",
      "mcp__*__create_edge_function_secret",
      "mcp__*__request_promote",
      "mcp__*__request_rollback",
      "mcp__*__create_project_env",
      "mcp__*__edit_project_env",
      "mcp__*__update_project",
      "mcp__*__create_deployment",
      "mcp__*__assign_alias",
      "mcp__*__put_firewall_config",
      "mcp__*__update_firewall_config",
      "mcp__*__update_attack_challenge_mode",
      "mcp__*__start_rolling_release",
      "mcp__*__complete_rolling_release",
      "mcp__*__approve_rolling_release_stage",
      "mcp__*__buy_*",
      "mcp__*__create_or_transfer_domain",
      "mcp__*__replace_domain_dns_records"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/start-docker.sh", "timeout": 60 },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/instalar-dependencias.sh", "timeout": 300 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guardian.mjs", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/revisor.mjs", "timeout": 15 }
        ]
      }
    ]
  }
}
